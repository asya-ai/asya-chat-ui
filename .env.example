APP_ENV=development
JWT_SECRET=...
DATABASE_URL=postgresql+asyncpg://chatui:chatui@postgres:5432/chatui
POSTGRES_USER=chatui
POSTGRES_PASSWORD=chatui
POSTGRES_DB=chatui
FILES_BASE_DIR=/data/files
ATTACHMENTS_MAX_FILES=50
ATTACHMENTS_MAX_FILE_BYTES=50000000
ATTACHMENTS_MAX_TOTAL_BYTES=100000000

OPENAI_API_KEY=...
OPENAI_BASE_URL=https://api.openai.com

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_VERTEX_JSON={}
# Optional; defaults to global when unset.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global

GROQ_API_KEY=...
GROQ_BASE_URL=https://api.groq.com/openai

ANTHROPIC_API_KEY=...
ANTHROPIC_BASE_URL=https://api.anthropic.com

PERPLEXITY_API_KEY=....
PERPLEXITY_MODEL=sonar-pro

# Must match the backend image build arg (model is downloaded at image build time).
AGENT_EMBEDDING_MODEL=BAAI/bge-m3

# Celery workers (compose).
WORKER_REPLICAS=1
WORKER_CONCURRENCY=2
# Recycle prefork children so ONNX/allocator growth does not stick forever.
# CELERY_MAX_TASKS_PER_CHILD=40
# CELERY_MAX_MEMORY_PER_CHILD_KB=2560000

# MCP servers are configured in Settings → Integrations (UI).
# MCP_CACHE_TTL_SECONDS=300
# MCP_CONNECT_TIMEOUT_SECONDS=15
# MCP_CALL_TIMEOUT_SECONDS=60
# MCP_MAX_RESULT_CHARS=50000
# MCP_SPILL_THRESHOLD_CHARS=8000
# MCP_SPILL_SAMPLE_CHARS=800
# MCP_SPILL_GET_MAX_CHARS=12000

# Microsoft Graph MCP (compose service `msgraph-mcp`).
# Must match Settings → Integrations → OAuth providers → Microsoft client/tenant.
# GRAPH_MCP_CLIENT_ID=
# GRAPH_MCP_TENANT_ID=common
# GRAPH_MCP_TOOLSETS=all
# GRAPH_MCP_WRITE_SCOPE=true
# GRAPH_MCP_IMAGE=ghcr.io/nitin27may/ms-graph-mcp:latest

SMTP_USER=
SMTP_PASSWORD=
SMTP_EMAIL=
SMTP_HOST=
SMTP_PORT=

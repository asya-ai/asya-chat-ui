APP_ENV=development
JWT_SECRET=...
DATABASE_URL=postgresql+asyncpg://chatui:chatui@postgres:5432/chatui
POSTGRES_USER=chatui
POSTGRES_PASSWORD=chatui
POSTGRES_DB=chatui
FILES_BASE_DIR=/data/files
ATTACHMENTS_MAX_FILES=50
ATTACHMENTS_MAX_FILE_BYTES=20000000
ATTACHMENTS_MAX_TOTAL_BYTES=50000000

OPENAI_API_KEY=...
OPENAI_BASE_URL=https://api.openai.com

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

GEMINI_API_KEY=...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_VERTEX_JSON={}
# Optional; defaults to global when unset.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global

GROQ_API_KEY=...
GROQ_BASE_URL=https://api.groq.com/openai

ANTHROPIC_API_KEY=...
ANTHROPIC_BASE_URL=https://api.anthropic.com

PERPLEXITY_API_KEY=....
PERPLEXITY_MODEL=sonar-pro

# Must match the backend image build arg (model is downloaded at image build time).
AGENT_EMBEDDING_MODEL=BAAI/bge-m3

# Celery workers (compose).
WORKER_REPLICAS=1
WORKER_CONCURRENCY=2

# MCP data sources (host ./config → /config/mcp_servers.yaml; path is fixed).
# MCP_CACHE_TTL_SECONDS=300
# MCP_CALL_TIMEOUT_SECONDS=60
# MCP_MAX_RESULT_CHARS=50000
# Example for authenticated servers in config/mcp_servers.yaml:
# SOME_API_TOKEN=

SMTP_USER=
SMTP_PASSWORD=
SMTP_EMAIL=
SMTP_HOST=
SMTP_PORT=
